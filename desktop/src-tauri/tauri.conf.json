{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Media",
  "version": "0.1.3",
  "identifier": "com.homemedia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Home Media",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/home-media"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/marcpelve/home-media/releases/latest/download/{filename}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RTU2QzZCOUNDOENEQTMKUldTanpjaWNhMnpsVjByL3ljMGhWci9CQ1hxb0JJQ3dJc0ZTK3RJWDRhVGZVSUxoSlRyTElUYXoK"
    }
  }
}
