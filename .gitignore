# ============================================================
# home-media .gitignore
# Secrets and runtime data must NEVER be committed.
# ============================================================

# Secrets / local config
.env
.env.*
!.env.example
config/
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build / packaging (PyInstaller + Tauri)
dist/
build/
.tauri/
*.exe
backend/dist/
backend/build-console/
target/
desktop/dist/
desktop/src-tauri/resources/home-media/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
