# home-media backend configuration (development).
#
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored and must NEVER be committed.
#
# In the packaged desktop app these values are set through the in-app
# Settings tab (stored in the local %LOCALAPPDATA% database), so this file
# is only needed for local development.

# TMDB v4 read token (https://www.themoviedb.org/settings/api)
TMDB_READ_ACCESS_TOKEN=

# Torbox API key (debrid)
TORBOX_API_KEY=

# Trakt client id (https://trakt.tv/oauth/applications)
TRAKT_CLIENT_ID=

# Optional overrides. When unset, paths resolve relative to the app
# (dev: repo root; packaged: %LOCALAPPDATA%\HomeMedia).
# DOWNLOAD_DIR=
# POSTER_DIR=
# DB_PATH=
# MPV_PATH=
